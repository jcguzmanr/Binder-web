# Otros formularios del sitio (casos de uso, diagnóstico, etc.) pueden seguir usando:
# VITE_WEBHOOK_URL=

# Formulario de contacto en el home (componente Contact) → workflow `binderla-formulario`.
# POST sin /initialize (se normaliza en código). JSON: name (nombre completo), company, email,
# phone y telefono (mismo valor o null), phoneCountry, challenge, consent, timestamp, source "contact-form".
VITE_HOME_CONTACT_WEBHOOK_URL=https://binder0.bubbleapps.io/version-test/api/1.1/wf/binderla-formulario/initialize

# Eventos / webinar y formulario “Agenda tu demo” del landing → mismo workflow Bubble `evento-de-cierre`.
# POST sin /initialize si aplica. Payload: firstName, lastName, email, jobTitle, company, phone, phoneCountry, consent, timestamp.
VITE_EVENTS_WEBHOOK_URL=https://binder0.bubbleapps.io/version-test/api/1.1/wf/evento-de-cierre

# LinkedIn Insight Tag — only loads on event pages when set
# VITE_LINKEDIN_PARTNER_ID=
